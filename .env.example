# ============================================================================
# Minnesota Park & Campsite Explorer - Environment Configuration
# Copy this file to .env and fill in your credentials.
# See SETUP.md for step-by-step instructions on obtaining Google credentials.
# ============================================================================

# --- Application Settings ---
APP_NAME="Minnesota Park & Campsite Explorer"
APP_ENV="production"
APP_HOST="0.0.0.0"
APP_PORT=8000
SESSION_SECRET_KEY="change-me-to-a-secure-random-hex-string-in-production"

# --- Google Sheets Configuration ---
# Default points to the Minnesota Park Information Google Sheet
GOOGLE_SHEET_ID="1CW-0euFLFz24nzcXNrTY24IoqTX9BCHLX5fdLjxAHgk"
GOOGLE_SHEET_GID="459530859"
# Optional: Google Sheets API v4 key (if omitted, uses direct CSV export from the sheet)
GOOGLE_SHEETS_API_KEY=""
# Cache TTL in seconds before re-fetching from Google Sheets (default: 1800 = 30 mins)
SHEET_CACHE_TTL_SECONDS=1800

# --- Google Maps Configuration ---
# Google Maps JavaScript API Key (with Maps JavaScript API enabled)
# If left empty, the UI automatically falls back to an interactive OpenStreetMap/Topo map
# and also lets you test a key directly from the UI settings menu.
GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# --- Federated Google IdP (OAuth 2.0 / OIDC) Configuration ---
# Create an OAuth 2.0 Client ID (Web Application) in Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match one of the Authorized Redirect URIs in your Google Cloud OAuth Client
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/callback"

# Allow a local demo sign-in when Google OAuth credentials are not yet configured
ENABLE_DEMO_AUTH=true

# --- Local Persistence (Favorites & User Notes) ---
DATABASE_PATH="/app/data/app.db"
